## Build output, temporary files and files generated by .NET tools. For Visual Studio IDE
## files, add the entries from
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore.
##
## Based on https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# BenchmarkDotNet artifacts
BenchmarkDotNet.Artifacts/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Office lock files, editor backup files, code coverage output
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Public API listings the PublicApiTests write when the surface differs from api/*.txt
api/*.received.txt

# macOS Finder metadata
.DS_Store
