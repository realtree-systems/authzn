<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- AuthznVersion is passed by run.sh: the version of the package under test. -->
    <PackageReference Include="Authzn" Version="$(AuthznVersion)" />
  </ItemGroup>

</Project>
